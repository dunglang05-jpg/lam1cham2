<Window x:Class="LamMotCham.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Làm 1 Chạm" Height="860" Width="1440"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Sidebar" Color="#101B2E"/>
        <SolidColorBrush x:Key="Line" Color="#E7ECF3"/>
        <SolidColorBrush x:Key="SoftBlue" Color="#EEF3FF"/>
        <SolidColorBrush x:Key="Green" Color="#15966A"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Padding" Value="12,13"/>
            <Setter Property="Background" Value="#FAFBFD"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}">
            <Grid Margin="22,25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#3366E8">
                        <TextBlock Text="1" Foreground="White" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LÀM 1 CHẠM" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="LAPTOP SETUP PRO" Foreground="#91A2C0" FontSize="9"
                                   FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="KHÔNG GIAN LÀM VIỆC" Foreground="#71819D"
                               FontSize="9" FontWeight="Bold" Margin="5,0,0,12"/>
                    <Border Background="#243653" CornerRadius="9" Padding="12,11" Margin="0,0,0,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Foreground="#8EAEFF" FontSize="17" Width="28"/>
                            <TextBlock Text="Tổng quan" Foreground="White" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="12,11,0,11">
                        <TextBlock Text="▣" Foreground="#9AA9C2" FontSize="16" Width="28"/>
                        <TextBlock Text="Checklist bàn giao" Foreground="#C2CCDC" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,8,0,11">
                        <TextBlock Text="↓" Foreground="#9AA9C2" FontSize="18" Width="28"/>
                        <TextBlock Text="Cài đặt phần mềm" Foreground="#8796AF" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,8,0,11">
                        <TextBlock Text="⚙" Foreground="#9AA9C2" FontSize="16" Width="28"/>
                        <TextBlock Text="Tối ưu Windows" Foreground="#8796AF" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,8,0,11">
                        <TextBlock Text="▤" Foreground="#9AA9C2" FontSize="16" Width="28"/>
                        <TextBlock Text="Quản lý ổ đĩa" Foreground="#8796AF" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,8,0,11">
                        <TextBlock Text="☷" Foreground="#9AA9C2" FontSize="16" Width="28"/>
                        <TextBlock Text="Lịch sử tác vụ" Foreground="#8796AF" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="4" Background="#1B2A43" CornerRadius="12" Padding="13">
                    <StackPanel>
                        <TextBlock Text="PHIÊN BẢN HIỆN TẠI" Foreground="#8192AE" FontSize="9" FontWeight="Bold"/>
                        <TextBlock Text="Bản nền tảng" Foreground="White" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,7,0,3"/>
                        <TextBlock Text="Các module nâng cao sẽ được bổ sung theo từng giai đoạn."
                                   Foreground="#9BAAC0" FontSize="10" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main dashboard -->
        <Grid Grid.Column="1" Margin="32,27,32,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel>
                    <TextBlock Text="TRUNG TÂM ĐIỀU KHIỂN" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Tổng quan thiết bị" FontSize="26" FontWeight="Bold" Margin="0,5,0,3"/>
                    <TextBlock Text="Theo dõi checklist và thông tin máy trước khi bàn giao."
                               Foreground="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="White" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="9" Padding="12,9" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#19A675" Margin="0,0,8,0"/>
                        <TextBlock Text="Ứng dụng sẵn sàng" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Summary cards -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="13"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="13"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CHECKLIST HOÀN TẤT" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="ProgressText" Text="0 / 5 mục" FontSize="22"
                                   FontWeight="Bold" Margin="0,8,0,3"/>
                        <TextBlock Text="Tiến độ bàn giao hiện tại" Foreground="{StaticResource Muted}" FontSize="10"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="THIẾT BỊ" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="DeviceName" Text="Chưa xác định" FontSize="18"
                                   FontWeight="Bold" Margin="0,9,0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Tên máy tính đang sử dụng" Foreground="{StaticResource Muted}" FontSize="10"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TRẠNG THÁI" Style="{StaticResource Eyebrow}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                            <Ellipse Width="9" Height="9" Fill="#19A675" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Sẵn sàng kiểm tra" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Chưa chạy tác vụ hệ thống" Foreground="{StaticResource Muted}" FontSize="10"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Work area -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.42*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="19">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="False">
                            <StackPanel>
                                <TextBlock Text="Checklist bàn giao" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Kỹ thuật viên xác nhận từng hạng mục sau khi kiểm tra."
                                           Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource SoftBlue}"
                                    CornerRadius="7" Padding="9,6" VerticalAlignment="Center">
                                <TextBlock Text="5 HẠNG MỤC" Foreground="{StaticResource Accent}"
                                           FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChecklistPanel" Margin="0,2,4,0"/>
                        </ScrollViewer>
                        <DockPanel Grid.Row="3" Margin="0,11,0,0" LastChildFill="False">
                            <TextBlock Text="Tiến độ được lưu trên máy này." Foreground="{StaticResource Muted}"
                                       FontSize="9" VerticalAlignment="Center"/>
                            <Button Content="Lưu tiến độ" DockPanel.Dock="Right" Click="Save_Click" Padding="15,9"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Thông tin hệ thống" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Thông tin cơ bản được đọc trực tiếp từ Windows."
                                       Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,13"/>
                            <Border Background="#F7F9FC" CornerRadius="9" Padding="12" Margin="0,0,0,12">
                                <TextBlock x:Name="DeviceDetails"
                                           Text="Chưa đọc thông tin thiết bị. Bấm nút bên dưới để kiểm tra tên máy, tài khoản và hệ điều hành."
                                           TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                           FontSize="10" LineHeight="18"/>
                            </Border>
                            <Button Content="Đọc thông tin máy" Click="ReadDevice_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SoftBlue}" CornerRadius="13" Padding="17" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="LƯU Ý AN TOÀN" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="Phiên bản hiện tại chỉ đọc thông tin thiết bị và lưu checklist. Các thao tác cài đặt, tối ưu Windows và phân vùng ổ đĩa chưa được kích hoạt."
                                       Foreground="{StaticResource Ink}" FontSize="10" TextWrapping="Wrap"
                                       LineHeight="17" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="Nhật ký phiên làm việc" FontSize="14" FontWeight="Bold"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Ứng dụng đã khởi động. Chưa có thao tác nào được thực hiện."
                                       Foreground="{StaticResource Muted}" FontSize="10"
                                       TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="6" LastChildFill="False">
                <TextBlock Text="LÀM 1 CHẠM  •  QUẢN LÝ THIẾT LẬP LAPTOP"
                           Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/>
                <TextBlock Text=".NET 10  |  WPF" Foreground="{StaticResource Muted}"
                           FontSize="9" VerticalAlignment="Center" DockPanel.Dock="Right"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
