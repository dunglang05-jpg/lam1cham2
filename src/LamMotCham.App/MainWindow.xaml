<Window x:Class="LamMotCham.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Làm 1 Chạm" Height="800" Width="1280" MinHeight="680" MinWidth="1020" WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,14,0"/></Style>
  </Window.Resources>
  <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><StackPanel><TextBlock Text="LÀM 1 CHẠM" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="Sẵn sàng bàn giao" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,5,0,0"/><TextBlock Text="Quy trình thiết lập laptop rõ ràng, nhất quán và dễ kiểm tra." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="White" CornerRadius="12" Padding="16,10" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="#24A879" Margin="0,0,9,0"/><TextBlock Text="Sẵn sàng làm việc" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/></StackPanel></Border></DockPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="16" Padding="24"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="Danh sách bàn giao" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock x:Name="ProgressText" Text="0 / 5 mục hoàn tất" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChecklistPanel"/></ScrollViewer></DockPanel></Border>
      <StackPanel Grid.Column="2"><Border Background="White" CornerRadius="16" Padding="22" Margin="0,0,0,18"><StackPanel><TextBlock Text="THÔNG TIN THIẾT BỊ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DeviceName" Text="Chưa đọc thông tin" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,10,0,4"/><TextBlock x:Name="DeviceDetails" Text="Bấm nút bên dưới để lấy thông tin từ máy này." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><Button Content="Đọc thông tin máy" Click="ReadDevice_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
        <Border Background="#EAF0FF" CornerRadius="16" Padding="22"><StackPanel><TextBlock Text="LƯU Ý" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="Các mục trong danh sách do kỹ thuật viên xác nhận thủ công. Ứng dụng không tự cài đặt phần mềm hoặc thay đổi cấu hình Windows." TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,10,0,0" LineHeight="22"/></StackPanel></Border>
      </StackPanel>
    </Grid>
    <DockPanel Grid.Row="4"><TextBlock x:Name="StatusText" Text="Dữ liệu checklist được lưu trên máy này." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button Content="Lưu tiến độ" DockPanel.Dock="Right" Click="Save_Click"/></DockPanel>
  </Grid>
</Window>
